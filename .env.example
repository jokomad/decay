# ==============================================================================
# BYBIT DECAY SCREENER & AUTOMATED SHORT GRID BOT CONFIGURATION
# ==============================================================================

# Server Port
PORT=3000

# ------------------------------------------------------------------------------
# 1. BYBIT API CREDENTIALS FOR GRID BOT EXECUTION
# ------------------------------------------------------------------------------
# Create an API Key on Bybit (Main Account or Subaccount) with Permissions:
# - Contract: Orders (Read-Write), Positions (Read-Write)
# - Bots: Trading Bot / Grid Bot access
BYBIT_BOT_API_KEY=your_bybit_api_key_here
BYBIT_BOT_API_SECRET=your_bybit_api_secret_here

# Bybit Environment: Set to true for Bybit Testnet (api-testnet.bybit.com)
# Set to false for Bybit Mainnet (api.bybit.com)
BYBIT_TESTNET=false

# ------------------------------------------------------------------------------
# 2. SHORT GRID BOT STRATEGY PARAMETERS
# ------------------------------------------------------------------------------
# Total USDT investment per bot (Default: 100 USDT)
BOT_INVESTMENT=100

# Leverage multiplier (Default: 2 for 2.0x Cross Leverage)
BOT_LEVERAGE=2

# Number of geometric grid levels between [-30%, +70%]
BOT_GRIDS=40

# Take Profit percentage (Default: 1% => +1.00 USDT profit target)
BOT_TP_PERCENT=1

# ------------------------------------------------------------------------------
# 3. MONGODB PERSISTENCE (OPTIONAL)
# ------------------------------------------------------------------------------
# Free persistent database on Northflank, MongoDB Atlas, or local.
# If omitted or unavailable, the system automatically falls back to persistent
# JSON storage on local disk inside D:\BybitDecay\.data/
MONGODB_URI=
MONGODB_DB_NAME=bybit_screener

# ------------------------------------------------------------------------------
# 4. SYSTEM MAINTENANCE & RESTART TIMING
# ------------------------------------------------------------------------------
# Daily clean restart hour (UTC 0-23). Default is 04:05 UTC (between :01 and :14).
DAILY_RESTART_HOUR=4
